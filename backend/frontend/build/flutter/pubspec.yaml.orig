name: 'saludnow'
description: 'Aplicación Salud Now'
publish_to: none
version: 1.0.0+1
environment:
  sdk: '>=3.1.5 <4.0.0'
dependencies:
  flutter:
    sdk: flutter
  flutter_web_plugins:
    sdk: flutter
  cupertino_icons: ^1.0.8
  flet: 1.0.0
  serious_python: 4.7.0
  msgpack_dart: ^1.0.1
  package_info_plus: ^9.0.0
  path_provider: ^2.1.4
  path: ^1.9.0
  window_manager: ^0.5.1
dependency_overrides:
  flet: 1.0.0
  screen_retriever: 0.2.1
  jni: 1.0.0
dev_dependencies:
  flutter_lints: ^2.0.0
flutter:
  uses-material-design: true
